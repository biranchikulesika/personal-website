# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.production on your hosting platform.
# Do NOT commit .env.production to Git.

# Data source — must be "supabase" in production
DATA_SOURCE="supabase"

# Authentication — must be "true" in production
AUTH_ENABLED="true"

# ── Supabase ──────────────────────────────────────────────────────────────────
# From Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_SECRET_KEY="your-service-role-key"

# ── AI Metadata Service (optional) ────────────────────────────────────────────
# Falls back to local heuristic metadata generation if not set.
# OPENAI_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_BASE_URL=""
# AI_MODEL=""

# ── Razorpay (if payments are enabled) ────────────────────────────────────────
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# ── Revalidation ──────────────────────────────────────────────────────────────
# CRON_SECRET=""
# REVALIDATION_SECRET=""
