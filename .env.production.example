# =============================================================================
# BIRANCHI KULESIKA — PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# =============================================================================
# Copy this file to .env.production or configure these variables in your hosting
# provider's environment settings dashboard (e.g., Vercel, Railway, Fly.io).
#
# NEVER commit .env.production or actual production credentials to Git.
# =============================================================================


# =============================================================================
# 1. CORE APPLICATION & DATA SOURCE
# =============================================================================

# -----------------------------------------------------------------------------
# DATA_SOURCE
# -----------------------------------------------------------------------------
# 1. Variable name: DATA_SOURCE
# 2. What it is: Primary switch controlling the data persistence adapter.
# 3. Why the app needs it: Must be set to supabase in production to connect to
#    the live PostgreSQL database.
# 4. Where to get it: Set explicitly to supabase.
# 5. Expected format: supabase
# 6. Used by:
#    - lib/config/env.ts -> getDataSource()
#    - lib/repositories/index.ts -> getContentRepository()
# 7. Server/client: Server-only.
# 8. Security implications: Non-secret. Throws a loud exception if set to invalid values.
# 9. Common mistakes: Leaving as mock in production (data will reset on restart).
# 10. Troubleshooting: Verify DATA_SOURCE=supabase in your hosting environment settings.
# 11. Required: Yes (Must be supabase in production).
# 12. Environment behavior: Production requires supabase.
# -----------------------------------------------------------------------------
DATA_SOURCE=supabase


# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL
# -----------------------------------------------------------------------------
# 1. Variable name: NEXT_PUBLIC_SITE_URL
# 2. What it is: The canonical production domain URL.
# 3. Why the app needs it: Required for generating canonical SEO tags, sitemap.xml,
#    robots.txt, dynamic Open Graph images, JSON-LD structured schemas, and OAuth callbacks.
# 4. Where to get it: Your production custom domain.
# 5. Expected format: Full HTTPS URL without trailing slash (e.g., https://biranchikulesika.com).
# 6. Used by:
#    - lib/constants.ts -> SITE_URL
#    - lib/seo.ts -> rootMetadata, postMetadata, noteMetadata, websiteJsonLd
#    - app/sitemap.ts -> dynamic sitemap entries
#    - app/robots.ts -> sitemap link
#    - app/admin/login/actions.ts -> OAuth redirect URL
# 7. Server/client: Client-safe (prefixed with NEXT_PUBLIC_).
# 8. Security implications: Public value. Ensure HTTPS is used.
# 9. Common mistakes: Adding a trailing slash (e.g., https://biranchikulesika.com/),
#    which produces invalid double slashes in canonical links.
# 10. Troubleshooting: If canonical tags or sitemaps show http://localhost:3000,
#     set this variable in your hosting provider's environment settings.
# 11. Required: Yes.
# 12. Environment behavior: Set to your public production domain with https://.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://biranchikulesika.com


# =============================================================================
# 2. SUPABASE (POSTGRESQL DATABASE & STORAGE)
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE_URL
# -----------------------------------------------------------------------------
# 1. Variable name: SUPABASE_URL
# 2. What it is: The HTTPS endpoint URL of your production Supabase project.
# 3. Why the app needs it: Initializes Supabase clients for querying tables,
#    authenticating sessions, and accessing public storage assets.
# 4. Where to get it:
#    Supabase Dashboard (https://supabase.com/dashboard)
#    → Select your production project
#    → Project Settings (Gear icon in sidebar)
#    → API
#    → Project URL
# 5. Expected format: https://<project-ref>.supabase.co
# 6. Used by:
#    - lib/supabase/server.ts -> getSupabaseAdmin(), getSupabasePublic(), getSupabaseServer()
#    - app/admin/login/actions.ts
#    - app/admin/auth/callback/route.ts
# 7. Server/client: Client-safe (prefixed with NEXT_PUBLIC_).
# 8. Security implications: Public endpoint. Protected by Row-Level Security (RLS).
# 9. Common mistakes: Copying the postgres:// connection pooler URL instead of the HTTPS API URL.
# 10. Troubleshooting: Check project status in Supabase dashboard if connection times out.
# 11. Required: Yes (when DATA_SOURCE=supabase).
# 12. Environment behavior: Production Supabase project URL.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co


# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# -----------------------------------------------------------------------------
# 1. Variable name: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# 2. What it is: The Supabase anonymous/publishable API key.
# 3. Why the app needs it: Used for browser and server client operations that respect
#    Row-Level Security (RLS) policies (public content reads and user auth sessions).
# 4. Where to get it:
#    Supabase Dashboard
#    → Project Settings
#    → API
#    → Project API keys
#    → anon / public
# 5. Expected format: Long JWT string starting with eyJhbGciOi... or modern sb_pub_...
# 6. Used by:
#    - lib/supabase/server.ts -> getSupabasePublic(), getSupabaseServer()
#    - app/admin/login/actions.ts
#    - app/admin/auth/callback/route.ts
# 7. Server/client: Client-safe (prefixed with NEXT_PUBLIC_).
# 8. Security implications: Safe to expose in browsers. Data access is governed by RLS.
# 9. Common mistakes: Putting the service_role key here.
# 10. Troubleshooting: If public pages return 401, check that the key matches the project URL.
# 11. Required: Yes (when DATA_SOURCE=supabase).
# 12. Environment behavior: Production anon key.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...


# -----------------------------------------------------------------------------
# SUPABASE_SECRET_KEY
# -----------------------------------------------------------------------------
# 1. Variable name: SUPABASE_SECRET_KEY
# 2. What it is: The Supabase service-role administrative API secret key.
# 3. Why the app needs it: Used by the repository layer (SupabaseContentRepository)
#    to perform administrative CRUD operations, bypassing RLS on trusted server contexts.
# 4. Where to get it:
#    Supabase Dashboard
#    → Project Settings
#    → API
#    → Project API keys
#    → service_role (Secret)
# 5. Expected format: Long JWT string starting with eyJhbGciOi... or modern sb_secret_...
# 6. Used by:
#    - lib/supabase/server.ts -> getSupabaseAdmin()
# 7. Server/client: SERVER-ONLY (CRITICAL SECRET).
# 8. Security implications: CRITICAL. This key bypasses all Row-Level Security policies.
#    NEVER prefix with NEXT_PUBLIC_, never commit to Git, never import into client components.
#    If leaked, rotate immediately in the Supabase dashboard.
# 9. Common mistakes: Prefixing with NEXT_PUBLIC_ or committing to Git.
# 10. Troubleshooting: If server actions throw "Missing Supabase configuration", verify
#     SUPABASE_SECRET_KEY is present in your hosting environment variables.
# 11. Required: Yes (when DATA_SOURCE=supabase).
# 12. Environment behavior: Production service-role key.
# -----------------------------------------------------------------------------
SUPABASE_SECRET_KEY=eyJhbGciOi...


# =============================================================================
# 3. RAZORPAY (PATRONAGE & SUPPORT PAYMENTS)
# =============================================================================

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_RAZORPAY_KEY_ID
# -----------------------------------------------------------------------------
# 1. Variable name: NEXT_PUBLIC_RAZORPAY_KEY_ID
# 2. What it is: The public Razorpay Live Key ID for client-side checkout modal.
# 3. Why the app needs it: Initializes the Razorpay Checkout SDK popup on /support.
# 4. Where to get it:
#    Razorpay Dashboard (https://dashboard.razorpay.com)
#    → Account & Settings
#    → API Keys
#    → Generate / View Key ID (Live mode)
# 5. Expected format: rzp_live_xxxxxxxxxxxxxx
# 6. Used by:
#    - components/support-page.tsx -> RazorpayConstructor options
# 7. Server/client: Client-safe (prefixed with NEXT_PUBLIC_).
# 8. Security implications: Public identifier.
# 9. Common mistakes: Using Test key in production (payments will not be real).
# 10. Troubleshooting: Verify key starts with rzp_live_ in production.
# 11. Required: Optional (If unset, support modal falls back to simulated flow).
# 12. Environment behavior: Live key in production.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...


# -----------------------------------------------------------------------------
# RAZORPAY_KEY_SECRET
# -----------------------------------------------------------------------------
# 1. Variable name: RAZORPAY_KEY_SECRET
# 2. What it is: The private Razorpay API secret key for HMAC signature verification.
# 3. Why the app needs it: Cryptographically verifies payment signatures
#    (HMAC-SHA256 of order_id + payment_id) when confirming patronage.
# 4. Where to get it:
#    Razorpay Dashboard
#    → Account & Settings
#    → API Keys
#    → Key Secret (Live mode)
# 5. Expected format: 24+ character alphanumeric secret string.
# 6. Used by:
#    - lib/razorpay.ts -> verifyPaymentSignature()
#    - lib/services/content.service.ts -> confirmPayment()
# 7. Server/client: SERVER-ONLY (SECRET).
# 8. Security implications: Secret. Keep strictly server-side.
# 9. Common mistakes: Exposing in client bundles.
# 10. Troubleshooting: Ensure secret matches the exact Live Key ID configured above.
# 11. Required: Optional (Required if verifying Razorpay checkout signatures).
# 12. Environment behavior: Live secret in production.
# -----------------------------------------------------------------------------
# RAZORPAY_KEY_SECRET=...


# -----------------------------------------------------------------------------
# RAZORPAY_WEBHOOK_SECRET
# -----------------------------------------------------------------------------
# 1. Variable name: RAZORPAY_WEBHOOK_SECRET
# 2. What it is: Secret token used to verify Razorpay webhook payloads.
# 3. Why the app needs it: Validates the X-Razorpay-Signature HTTP header on POST requests
#    to /api/webhooks/razorpay to prevent spoofed payment captured events.
# 4. Where to get it:
#    Razorpay Dashboard
#    → Account & Settings
#    → Webhooks
#    → Add New Webhook (URL: https://biranchikulesika.com/api/webhooks/razorpay)
#    → Secret field
# 5. Expected format: Custom secret string chosen during webhook setup.
# 6. Used by:
#    - lib/razorpay.ts -> verifyWebhookSignature()
#    - lib/services/content.service.ts -> processRazorpayWebhook()
#    - app/api/webhooks/razorpay/route.ts
# 7. Server/client: SERVER-ONLY (SECRET).
# 8. Security implications: Secret. Prevents forged payment webhook calls.
# 9. Common mistakes: Copying the API key secret instead of the webhook secret.
# 10. Troubleshooting: Check webhook delivery logs in Razorpay dashboard for HTTP 400 errors.
# 11. Required: Optional (Required if receiving live Razorpay webhooks).
# 12. Environment behavior: Live webhook secret in production.
# -----------------------------------------------------------------------------
# RAZORPAY_WEBHOOK_SECRET=...


# =============================================================================
# 4. THIRD-PARTY SERVICES & INTEGRATIONS (OPTIONAL)
# =============================================================================

# -----------------------------------------------------------------------------
# PEXELS_API_KEY
# -----------------------------------------------------------------------------
# 1. Variable name: PEXELS_API_KEY
# 2. What it is: API key for Pexels photo search.
# 3. Why the app needs it: Fetches daily rotating high-resolution atmosphere wallpapers
#    for the admin login screen (/admin/login).
# 4. Where to get it:
#    Pexels API Portal (https://www.pexels.com/api/)
#    → Your API Key
# 5. Expected format: 56-character alphanumeric string.
# 6. Used by:
#    - lib/services/pexels.service.ts -> fetchFromPexels()
#    - app/api/login-background/route.ts
# 7. Server/client: SERVER-ONLY (SECRET).
# 8. Security implications: Secret API key.
# 9. Common mistakes: Exposing in client-side code.
# 10. Troubleshooting: If wallpapers fail to load, falls back to local curated images.
# 11. Required: Optional.
# 12. Environment behavior: Optional in production.
# -----------------------------------------------------------------------------
# PEXELS_API_KEY=...


# -----------------------------------------------------------------------------
# OPENAI_API_KEY / GROQ_API_KEY
# -----------------------------------------------------------------------------
# 1. Variable name: OPENAI_API_KEY or GROQ_API_KEY
# 2. What it is: LLM provider API key for editorial metadata generation.
# 3. Why the app needs it: Automatically generates suggested tags, persona classification,
#    and SEO descriptions in the MDX Composer (/admin/compose).
# 4. Where to get it:
#    OpenAI: https://platform.openai.com/api-keys
#    Groq: https://console.groq.com/keys
# 5. Expected format: sk-proj-... (OpenAI) or gsk_... (Groq).
# 6. Used by:
#    - lib/services/ai-metadata.service.ts -> generateDocumentAiMetadata()
# 7. Server/client: SERVER-ONLY (SECRET).
# 8. Security implications: Secret API key.
# 9. Common mistakes: Exposing in client-side code.
# 10. Troubleshooting: Falls back to deterministic local heuristic NLP if unset.
# 11. Required: Optional.
# 12. Environment behavior: Optional in production.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-...
# GROQ_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
