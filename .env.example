# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (CANONICAL)
# ==============================================================================
# This file serves as the single authoritative reference for configuring the application.
# Copy this file to `.env.local` or `.env` and fill in the values for your environment.
# Sensitive keys must NEVER be committed to version control.
#
# ── Quick Start 📋 ─────────────────────────────────────────────────────────
#
# 1. Copy this file to `.env.local`:
#    cp .env.example .env.local
#
# 2. Set the required Supabase credentials:
#    NEXT_PUBLIC_SUPABASE_URL              — your Supabase project URL
#    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  — your Supabase publishable key
#    SUPABASE_SECRET_KEY                   — your Supabase secret key (server-side only)
#
# 3. Start the dev server:
#    npm run dev
#
# ── How Persona Routing Works 🔀 ───────────────────────────────────────────
#
# The app has 4 personas (builder, operator, thinker, wanderer), each with
# their own pages under app/{persona}/...
#
# Production (subdomain-based):
#   builder.yourdomain.com/about  → proxy.ts rewrites to  /builder/about
#   operator.yourdomain.com/blogs → proxy.ts rewrites to  /operator/blogs
#   Direct /builder/about access is blocked (404) to enforce subdomain usage.
#
# Local development (path-based):
#   localhost:3000/builder/about  → proxy.ts allows direct access
#   localhost:3000/operator/blogs → proxy.ts allows direct access
#   proxy.ts detects NODE_ENV === 'development' and skips the 404 block.

# ------------------------------------------------------------------------------
# 1. SUPABASE (DATABASE, AUTH, STORAGE)
# ------------------------------------------------------------------------------

# NEXT_PUBLIC_SUPABASE_URL: The canonical HTTPS endpoint for your Supabase instance.
# - Required: Yes
# - Scope: Universal (Client & Server)
# - Example: "https://xyzcompany.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: The public/publishable API key for client-side authentication and RLS queries.
# - Required: Yes
# - Scope: Universal (Client & Server)
# - Example: "sb_pub_..." or JWT token
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# SUPABASE_SECRET_KEY: Highly privileged secret key for server-side trusted operations (bypasses RLS).
# - Required: Yes (for admin tasks, cron jobs, database migrations)
# - Scope: Server-side only (NEVER expose to client)
# - Example: "sb_sec_..." or service role secret
SUPABASE_SECRET_KEY="your-secret-key"

# ------------------------------------------------------------------------------
# 2. AUTOMATION & BACKGROUND JOBS
# ------------------------------------------------------------------------------

# CRON_SECRET: Secret authorization token for verifying automated cron requests.
# - Required: Yes (for /api/cron/* endpoints)
# - Scope: Server-side only
# - Example: "your-super-secret-cron-key"
CRON_SECRET=""

# REVALIDATION_SECRET: Secret token for the /api/revalidate on-demand ISR purge endpoint.
# - Required: Yes (for on-demand cache revalidation)
# - Scope: Server-side only
# - Example: "your-revalidation-secret-key"
REVALIDATION_SECRET=""

# GITHUB_TOKEN: GitHub Personal Access Token for fetching commit logs.
# - Required: Yes (for build logs generator script)
# - Scope: Server-side only
# - Example: "ghp_xxxxxxxxxxxxxxxxxxxx"
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 3. AI INTEGRATION (BUILD LOGS)
# ------------------------------------------------------------------------------

# AI_API_KEY: API authentication key for AI completions.
# - Required: Yes (if running automated build logs)
# - Scope: Server-side only
AI_API_KEY=""

# AI_MODEL: The AI model identifier for generating structured logs.
# - Required: No (defaults to "deepseek-ai/deepseek-v4-flash")
# - Scope: Server-side only
AI_MODEL="deepseek-ai/deepseek-v4-flash"

# AI_BASE_URL: Custom endpoint URL for OpenAI-compatible AI API providers.
# - Required: No (defaults to "https://integrate.api.nvidia.com/v1/chat/completions")
# - Scope: Server-side only
AI_BASE_URL=""

# ------------------------------------------------------------------------------
# 4. DOMAIN & ROUTING (PERSONA SUBDOMAINS)
# ------------------------------------------------------------------------------

# NEXT_PUBLIC_ROOT_DOMAIN: Base apex domain for the application.
# - Required: No (defaults to "biranchikulesika.com")
# - Scope: Universal (Client & Server)
# - Example: "biranchikulesika.com"
NEXT_PUBLIC_ROOT_DOMAIN=""

# NEXT_PUBLIC_USE_SUBDOMAINS: Enable multi-tenant subdomains for persona routing.
# - Required: No (defaults to "false")
# - Scope: Universal (Client & Server)
# - Values: "true" | "false"
NEXT_PUBLIC_USE_SUBDOMAINS="false"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (RAZORPAY INTEGRATION)
# ------------------------------------------------------------------------------

# NEXT_PUBLIC_RAZORPAY_KEY_ID: Public Key ID for Razorpay Checkout Modal.
# - Required: Yes (for donations/checkout)
# - Scope: Universal (Client & Server)
# - Example: "rzp_live_..." or "rzp_test_..."
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Secret API Key for Razorpay order generation & signature verification.
# - Required: Yes (for creating orders & verification)
# - Scope: Server-side only
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: Secret signature for verifying incoming Razorpay webhooks.
# - Required: Yes (for payment webhooks)
# - Scope: Server-side only
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. WEBAUTHN & PASSKEYS CONFIGURATION
# ------------------------------------------------------------------------------

# WEBAUTHN_RP_NAME: Human-readable Relying Party name displayed in device passkey prompts.
# - Required: No (defaults to "Biranchi CMS")
# - Scope: Server-side only
WEBAUTHN_RP_NAME="Biranchi CMS"

# WEBAUTHN_RP_ID: Relying Party identifier (domain without protocol or port).
# - Required: No (auto-derived: "localhost" in development, "biranchikulesika.com" in production)
# - Scope: Server-side only
# - Example: "biranchikulesika.com"
WEBAUTHN_RP_ID=""

# WEBAUTHN_ORIGIN: Trusted origin(s) for WebAuthn cryptographic verification.
# - Required: No (auto-derived: supports localhost in development, HTTPS apex/subdomains in production)
# - Scope: Server-side only
# - Example: "https://biranchikulesika.com"
WEBAUTHN_ORIGIN=""
