# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env` and adjust as needed.
#
# Supported data sources: "mock" (default) or "supabase"
# Supported auth: AUTH_ENABLED="true" (requires Supabase)

# Data source — "mock" for local dev, "supabase" for production
DATA_SOURCE="mock"

# Authentication — set to "true" to enable admin login protection
AUTH_ENABLED="false"

# -----------------------------------------------------------------------------
# Supabase (required when DATA_SOURCE="supabase")
# From Supabase dashboard → Settings → API
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
# SUPABASE_SECRET_KEY="your-service-role-key"

# -----------------------------------------------------------------------------
# Pexels (optional — daily login background)
# Falls back to solid dark background if not set.
# -----------------------------------------------------------------------------
# PEXELS_API_KEY=""

# -----------------------------------------------------------------------------
# AI Metadata Service (optional)
# Falls back to local heuristic metadata generation if not set.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_BASE_URL=""
# AI_MODEL=""
