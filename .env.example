[TEMPLATE]
# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# This file serves as a reference for configuring the application.
# Copy this file to `.env` or `.env.local` and fill in the values for your environment.
# Note: Key variables must never be committed to repository control.
#
# ── Quick Start 📋 ─────────────────────────────────────────────────────────
#
# 1. Copy this file to `.env`:
#    cp .env.example .env
#
# 2. Set the required Supabase credentials:
#    NEXT_PUBLIC_SUPABASE_URL      — your Supabase project URL
#    NEXT_PUBLIC_SUPABASE_ANON_KEY  — your Supabase anon key
#    SUPABASE_SERVICE_ROLE_KEY      — your Supabase service role key
#
# 3. Start the dev server:
#    npm run dev
#
# 4. Open http://localhost:3000 — persona pages work out-of-the-box:
#    - http://localhost:3000/builder
#    - http://localhost:3000/thinker/about
#    - http://localhost:3000/wanderer/blogs
#    - http://localhost:3000/operator
#
# ── How Persona Routing Works 🔀 ───────────────────────────────────────────
#
# The app has 4 personas (builder, operator, thinker, wanderer), each with
# their own pages under app/{persona}/...
#
# Production (subdomain-based):
#   builder.xxx.com/about  → proxy.ts rewrites to  /builder/about
#   operator.xxx.com/blogs → proxy.ts rewrites to  /operator/blogs
#   Direct /builder/about access is blocked (404) to enforce subdomain usage.
#
# Local development (path-based):
#   localhost:3000/builder/about  → proxy.ts allows direct access
#   localhost:3000/operator/blogs → proxy.ts allows direct access
#   The proxy.ts detects NODE_ENV === 'development' and skips the 404 block.
#
# Navigation links use getPersonaUrl() from lib/utils.ts, which returns
# path-based URLs (/builder/about) in dev and subdomain URLs in production.

# ------------------------------------------------------------------------------
# 1. DATABASE / BACKEND SERVICE (SUPABASE INTEGRATION)
# ------------------------------------------------------------------------------

# NEXT_PUBLIC_USE_SUPABASE: Toggle the persistent PostgreSQL repository database.
# - Required: Optional (defaults to true if NEXT_PUBLIC_SUPABASE_URL is provided)
# - Scope: Universal (Client & Server)
# - Values: "true" | "false"
NEXT_PUBLIC_USE_SUPABASE="true"

# NEXT_PUBLIC_SUPABASE_URL: The public API URL of your Supabase project instance.
# - Required: Yes (when using persistent Supabase mode)
# - Scope: Universal (Client & Server)
# - Example: "https://abcdefghijklmopqrst.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: The public anonymous API key for client-side queries.
# - Required: Yes (when using persistent Supabase mode)
# - Scope: Universal (Client & Server)
# - Example: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Highly privileged secret key for server-side operations.
# - Required: Yes (enables admin panels to bypass RLS rules safely on the server side)
# - Scope: Server-side only (MUST KEEP SECRET)
# - Example: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 2. AUTOMATION & BACKGROUND JOBS
# ------------------------------------------------------------------------------

# CRON_SECRET: Secret key for verifying automated cron requests.
# - Required: Yes (for secure cron endpoints)
# - Scope: Server-side only
# - Example: "your-super-secret-cron-key"
CRON_SECRET=""

# REVALIDATION_SECRET: Secret key for the /api/revalidate endpoint.
# Used by the admin panel to purge the ISR cache when content is published
# or updated. Falls back to CRON_SECRET if not set.
# - Required: No (falls back to CRON_SECRET)
# - Scope: Server-side only
# - Example: "a-different-secret-for-cache-purge"
REVALIDATION_SECRET=""

# GITHUB_TOKEN: GitHub Personal Access Token for fetching commit logs.
# - Required: Yes (for the build logs generation script)
# - Scope: Server-side only
# - Note: Must be a PAT with access to all private repositories listed in the watched list.
# - Example: "ghp_xxxxxxxxxxxxxxxxxxxx"
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 3. AI INTEGRATION (BUILD LOGS)
# ------------------------------------------------------------------------------

# AI_PROVIDER: Which AI provider to use for summarizing logs.
# - Required: No (defaults to 'nvidia')
# - Values: "nvidia"
AI_PROVIDER="nvidia"

# AI_API_KEY: The API key for your chosen AI provider.
# - Required: Yes (if generating AI logs)
# - Scope: Server-side only
AI_API_KEY=""

# AI_MODEL: The AI model to use for completion.
# - Required: No (defaults to 'deepseek-ai/deepseek-v4-flash')
AI_MODEL="deepseek-ai/deepseek-v4-flash"

# AI_BASE_URL: Custom base URL if using a custom provider.
# - Required: No
AI_BASE_URL=""

# (Optional specific provider keys, if not using generic AI_API_KEY)
NVIDIA_API_KEY=""

# ------------------------------------------------------------------------------
# 4. DOMAIN & ROUTING (PERSONA SUBDOMAINS)
# ------------------------------------------------------------------------------
# These two variables control how persona pages are routed.
# See the "How Persona Routing Works" section at the top for details.
#
# ── Local Development ───────────────────────────────────────────────────────
# Leave both at their defaults. Persona pages work via path-based URLs:
#   NEXT_PUBLIC_ROOT_DOMAIN=""        → falls back to biranchikulesika.com
#   NEXT_PUBLIC_USE_SUBDOMAINS="false" → getPersonaUrl() returns /builder/about
# proxy.ts automatically allows direct persona paths in dev mode.
#
# ── Production with Custom Domain ───────────────────────────────────────────
# Set your domain and enable subdomain routing:
#   NEXT_PUBLIC_ROOT_DOMAIN="biranchikulesika.com"
#   NEXT_PUBLIC_USE_SUBDOMAINS="true"
# Persona pages are accessible via subdomains:
#   builder.yourdomain.com  →  maps to  /builder
#   thinker.yourdomain.com  →  maps to  /thinker
#   wanderer.yourdomain.com →  maps to  /wanderer
#   operator.yourdomain.com →  maps to  /operator
# SEO metadata (SITE_URL, canonical URLs, OG images) uses this domain.

# NEXT_PUBLIC_ROOT_DOMAIN: Base domain for the application.
# - Required: No (falls back to "biranchikulesika.com")
# - Scope: Universal (Client & Server)
# - Used by: lib/config/seo.ts (SITE_URL), lib/utils.ts (getPersonaUrl), robots.ts, sitemap.ts
# - Example: "biranchikulesika.com"
NEXT_PUBLIC_ROOT_DOMAIN=""

# NEXT_PUBLIC_USE_SUBDOMAINS: Enable multi-tenant subdomains for persona routing.
# - Required: No (defaults to false)
# - Scope: Universal (Client & Server)
# - Values: "true" | "false"
# - When true + production: builder.yourdomain.com/about → /builder/about
# - When false or dev:       /builder/about (path-based)
NEXT_PUBLIC_USE_SUBDOMAINS="false"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (RAZORPAY INTEGRATION)
# ------------------------------------------------------------------------------

# NEXT_PUBLIC_RAZORPAY_KEY_ID: Public API Key ID for Razorpay Client
# - Required: Yes (for checkout)
# - Scope: Universal (Client & Server)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Secret API Key for Razorpay Server
# - Required: Yes (for creating orders & verification)
# - Scope: Server-side only
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: Secret signature for Webhook verification
# - Required: Yes (for webhooks)
# - Scope: Server-side only
RAZORPAY_WEBHOOK_SECRET=""
