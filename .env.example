# ==============================================================================
# ENVIRONMENT CONFIGURATION — EXPERIMENTAL REBUILD BRANCH
# ==============================================================================
# This branch is isolated and experimental. It must never connect to
# production services. Copy this file to `.env` (or rely on the defaults —
# everything below is the default) and adjust only as needed.
#
# The only supported data source is "mock". If you set DATA_SOURCE to a
# production value (supabase, postgres, production), the app will throw
# instead of silently connecting.

# Data source for the application. Only "mock" is allowed on this branch.
DATA_SOURCE="mock"

# Authentication is intentionally disabled on this branch.
# Setting AUTH_ENABLED=true will cause the app to throw.
AUTH_ENABLED="false"

# ------------------------------------------------------------------------------
# Do NOT add production credentials (Supabase, database, payment, AI, etc.)
# to this file. This branch must not be able to reach production services.
# ------------------------------------------------------------------------------